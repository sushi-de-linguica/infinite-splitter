<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The memory layer. Knows nothing about LiveSplit, WinForms or Unity, and targets
    netstandard2.0 so both the net481 component and the net8.0 test harness can
    consume it — which is what lets the whole stack be exercised on Linux.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>InfiniteMemory</AssemblyName>
    <RootNamespace>InfiniteSplitter</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
